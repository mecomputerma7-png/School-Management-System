digraph Activity {
graph [rankdir=TB, bgcolor="white", pad="0.4", nodesep="0.4", ranksep="0.55", label="Report Generation (UC-13)", labelloc=t, fontsize=22, fontname="DejaVu Sans", fontcolor="#14345B"];
node [shape=box, style="rounded,filled", fillcolor="#E9F2FD", color="#3574B5", penwidth=1.4, fontname="DejaVu Sans", fontsize=11, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#47647E", arrowsize=0.75];
start [label="Start", shape=ellipse, fillcolor="#163A64", color="#163A64", fontcolor="#FFFFFF"];
open [label="User opens Reports Center", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
auth [label="User permitted to view selected report?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
deny [label="Display access denied", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
filter [label="Select report and filter criteria", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
valid [label="Filters valid?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
correct [label="Show filter errors", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
query [label="Query authorized records from central database", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
ok [label="Query succeeds?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
error [label="Display retrieval error", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
data [label="Matching records available?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
empty [label="Show empty-state message", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
render [label="Format and preview report", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
export [label="Export / print permitted?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
output [label="Export or print report", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
end [label="End", shape=ellipse, fillcolor="#163A64", color="#163A64", fontcolor="#FFFFFF"];
start -> open [label=""];
open -> auth [label=""];
auth -> deny [label="No"];
deny -> end [label=""];
auth -> filter [label="Yes"];
filter -> valid [label=""];
valid -> correct [label="No"];
correct -> filter [label="Retry"];
valid -> query [label="Yes"];
query -> ok [label=""];
ok -> error [label="No"];
error -> end [label=""];
ok -> data [label="Yes"];
data -> empty [label="No"];
empty -> end [label=""];
data -> render [label="Yes"];
render -> export [label=""];
export -> output [label="Yes"];
export -> end [label="No"];
output -> end [label=""];
}
