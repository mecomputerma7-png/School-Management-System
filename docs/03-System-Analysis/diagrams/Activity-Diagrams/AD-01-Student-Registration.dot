digraph "AD-01-Student-Registration" {
	graph [bgcolor=white fontcolor="#16324f" fontname="DejaVu Sans" fontsize=22 label="AD 01 Student Registration" labelloc=t nodesep=0.48 pad=0.35 rankdir=TB ranksep=0.85]
	node [color="#406789" fontname="DejaVu Sans" fontsize=11 penwidth=1.4]
	edge [arrowsize=0.7 color="#657f99" fontname="DejaVu Sans" fontsize=9]
	nodesep=0.5 ranksep=0.55 splines=polyline
	s [label=Start fillcolor="#d5eee2" shape=ellipse style=filled]
	a [label="Enter student information" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	v [label="Data valid and complete?" fillcolor="#fff0d7" shape=diamond style=filled]
	dup [label="Duplicate student?" fillcolor="#fff0d7" shape=diamond style=filled]
	save [label="Create student record" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	en [label="Select academic year / section" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	elig [label="Eligible for selected section?" fillcolor="#fff0d7" shape=diamond style=filled]
	assign [label="Record enrollment / class assignment" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	done [label=Confirmation fillcolor="#d5eee2" shape=ellipse style=filled]
	err [label="Show validation errors" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	dupmsg [label="Reject duplicate registration" fillcolor="#d5eee2" shape=ellipse style=filled]
	enerr [label="Show assignment conflict" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	s -> a [label=""]
	a -> v [label=""]
	v -> err [label=No]
	err -> a [label=Correct]
	v -> dup [label=Yes]
	dup -> dupmsg [label=Yes]
	dup -> save [label=No]
	save -> en [label=""]
	en -> elig [label=""]
	elig -> enerr [label=No]
	enerr -> en [label=Correct]
	elig -> assign [label=Yes]
	assign -> done [label=""]
}
