digraph "AD-02-Grade-Management" {
	graph [bgcolor=white fontcolor="#16324f" fontname="DejaVu Sans" fontsize=22 label="AD 02 Grade Management" labelloc=t nodesep=0.48 pad=0.35 rankdir=TB ranksep=0.85]
	node [color="#406789" fontname="DejaVu Sans" fontsize=11 penwidth=1.4]
	edge [arrowsize=0.7 color="#657f99" fontname="DejaVu Sans" fontsize=9]
	nodesep=0.5 ranksep=0.55 splines=polyline
	s [label=Start fillcolor="#d5eee2" shape=ellipse style=filled]
	a [label="Teacher selects assigned class / subject" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	auth [label="Authorized and grading period open?" fillcolor="#fff0d7" shape=diamond style=filled]
	deny [label="Deny entry / editing" fillcolor="#d5eee2" shape=ellipse style=filled]
	enter [label="Enter or update grade values" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	valid [label="Grades within configured limits?" fillcolor="#fff0d7" shape=diamond style=filled]
	fix [label="Display invalid values" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	save [label="Save grades" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	review [label="Authorized reviewer checks completeness" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	complete [label="All mandatory components complete?" fillcolor="#fff0d7" shape=diamond style=filled]
	pending [label="Request missing grades" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	calc [label="Calculate results using approved rules" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	final [label="Finalize grading period / lock grades" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	end [label="Finalized results" fillcolor="#d5eee2" shape=ellipse style=filled]
	s -> a [label=""]
	a -> auth [label=""]
	auth -> deny [label=No]
	auth -> enter [label=Yes]
	enter -> valid [label=""]
	valid -> fix [label=No]
	fix -> enter [label=Correct]
	valid -> save [label=Yes]
	save -> review [label=""]
	review -> complete [label=""]
	complete -> pending [label=No]
	pending -> enter [label=Complete]
	complete -> calc [label=Yes]
	calc -> final [label=""]
	final -> end [label=""]
}
