digraph "AD-04-Authentication" {
	graph [bgcolor=white fontcolor="#16324f" fontname="DejaVu Sans" fontsize=22 label="AD 04 Authentication" labelloc=t nodesep=0.48 pad=0.35 rankdir=TB ranksep=0.85]
	node [color="#406789" fontname="DejaVu Sans" fontsize=11 penwidth=1.4]
	edge [arrowsize=0.7 color="#657f99" fontname="DejaVu Sans" fontsize=9]
	nodesep=0.5 ranksep=0.55 splines=polyline
	s [label=Start fillcolor="#d5eee2" shape=ellipse style=filled]
	a [label="User submits credentials" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	limit [label="Login attempt permitted?" fillcolor="#fff0d7" shape=diamond style=filled]
	blocked [label="Apply temporary restriction" fillcolor="#d5eee2" shape=ellipse style=filled]
	check [label="Credentials valid and account active?" fillcolor="#fff0d7" shape=diamond style=filled]
	error [label="Reject login / show safe error" fillcolor="#d5eee2" shape=ellipse style=filled]
	session [label="Create authenticated session" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	request [label="User requests protected operation" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	role [label="Required permission granted?" fillcolor="#fff0d7" shape=diamond style=filled]
	deny [label="Deny operation; audit if required" fillcolor="#d5eee2" shape=ellipse style=filled]
	allow [label="Perform authorized operation" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	logout [label="Logout or idle timeout" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	end [label="Invalidate session" fillcolor="#d5eee2" shape=ellipse style=filled]
	s -> a [label=""]
	a -> limit [label=""]
	limit -> blocked [label=No]
	limit -> check [label=Yes]
	check -> error [label=No]
	check -> session [label=Yes]
	session -> request [label=""]
	request -> role [label=""]
	role -> deny [label=No]
	role -> allow [label=Yes]
	allow -> logout [label=""]
	logout -> end [label=""]
}
