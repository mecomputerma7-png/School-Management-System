digraph "AD-03-Fee-Management" {
	graph [bgcolor=white fontcolor="#16324f" fontname="DejaVu Sans" fontsize=22 label="AD 03 Fee Management" labelloc=t nodesep=0.48 pad=0.35 rankdir=TB ranksep=0.85]
	node [color="#406789" fontname="DejaVu Sans" fontsize=11 penwidth=1.4]
	edge [arrowsize=0.7 color="#657f99" fontname="DejaVu Sans" fontsize=9]
	nodesep=0.5 ranksep=0.55 splines=polyline
	s [label=Start fillcolor="#d5eee2" shape=ellipse style=filled]
	a [label="Accountant selects student fee account" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	balance [label="Retrieve assessed fees / balance" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	payment [label="Enter payment amount / details" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	valid [label="Valid positive amount within policy?" fillcolor="#fff0d7" shape=diamond style=filled]
	fix [label="Show payment error" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	post [label="Post payment atomically / issue receipt" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	ok [label="Transaction successful?" fillcolor="#fff0d7" shape=diamond style=filled]
	fail [label="Roll back transaction / report failure" fillcolor="#d5eee2" shape=ellipse style=filled]
	correction [label="Correction requested later?" fillcolor="#fff0d7" shape=diamond style=filled]
	finish [label="Updated balance / receipt" fillcolor="#d5eee2" shape=ellipse style=filled]
	permission [label="Correction authorized with reason?" fillcolor="#fff0d7" shape=diamond style=filled]
	reject [label="Reject correction" fillcolor="#d5eee2" shape=ellipse style=filled]
	reverse [label="Post corrective transaction; preserve original" fillcolor="#e8f3fd" shape=box style="rounded,filled"]
	end [label="Recalculated balance / audit record" fillcolor="#d5eee2" shape=ellipse style=filled]
	s -> a [label=""]
	a -> balance [label=""]
	balance -> payment [label=""]
	payment -> valid [label=""]
	valid -> fix [label=No]
	fix -> payment [label=Correct]
	valid -> post [label=Yes]
	post -> ok [label=""]
	ok -> fail [label=No]
	ok -> correction [label=Yes]
	correction -> finish [label=No]
	correction -> permission [label=Yes]
	permission -> reject [label=No]
	permission -> reverse [label=Yes]
	reverse -> end [label=""]
}
