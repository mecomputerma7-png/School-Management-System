digraph Activity {
graph [rankdir=TB, bgcolor="white", pad="0.4", nodesep="0.4", ranksep="0.55", label="Grade Entry and Finalization (UC-07 / UC-08)", labelloc=t, fontsize=22, fontname="DejaVu Sans", fontcolor="#14345B"];
node [shape=box, style="rounded,filled", fillcolor="#E9F2FD", color="#3574B5", penwidth=1.4, fontname="DejaVu Sans", fontsize=11, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#47647E", arrowsize=0.75];
start [label="Start", shape=ellipse, fillcolor="#163A64", color="#163A64", fontcolor="#FFFFFF"];
open [label="Teacher opens assigned assessment", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
perm [label="Authorized for section and subject?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
deny [label="Access denied", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
locked [label="Grades already finalized?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
lockedmsg [label="Display read-only grades", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
entry [label="Enter grades for enrolled students", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
check [label="Scores within assessment bounds?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
correct [label="Correct invalid scores", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
save [label="Save draft grades transactionally", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
ok [label="Save successful?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
error [label="Rollback; display error", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
review [label="Authorized reviewer examines grades", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
approve [label="All grades complete and approved?", shape=diamond, fillcolor="#FFF1CD", color="#D19C28", fontcolor="#18334F"];
revise [label="Return for correction", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
final [label="Finalize grades; lock approved results", shape=box, fillcolor="#E9F2FD", color="#3574B5", fontcolor="#18334F"];
end [label="End", shape=ellipse, fillcolor="#163A64", color="#163A64", fontcolor="#FFFFFF"];
start -> open [label=""];
open -> perm [label=""];
perm -> deny [label="No"];
deny -> end [label=""];
perm -> locked [label="Yes"];
locked -> lockedmsg [label="Yes"];
lockedmsg -> end [label=""];
locked -> entry [label="No"];
entry -> check [label=""];
check -> correct [label="No"];
correct -> entry [label="Retry"];
check -> save [label="Yes"];
save -> ok [label=""];
ok -> error [label="No"];
error -> end [label=""];
ok -> review [label="Yes"];
review -> approve [label=""];
approve -> revise [label="No"];
revise -> entry [label="Revise"];
approve -> final [label="Yes"];
final -> end [label=""];
}
