digraph SMS_ERD {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.42, ranksep=1.25, splines=polyline, overlap=false, outputorder=edgesfirst];
node [shape=plain, fontname="Arial"];
edge [color="#7a8799", arrowsize=0.65, penwidth=1.1, fontname="Arial", fontsize=8];
