@startuml
title SD-01 - User Authentication
autonumber
skinparam sequenceMessageAlign center
participant "User" as P0
participant "Login UI" as P1
participant "Auth Service" as P2
participant "User Repository" as P3
participant "Database" as P4
P0 -> P1 : Submit username + password
P1 -> P2 : authenticate(credentials)
P2 -> P3 : findByUsername(username)
P3 -> P4 : SELECT user, hash, status, roles
P4 -> P3 : Account record / not found
P3 -> P2 : Account record
P2 -> P2 : Verify hash + active status
note over P1: alt: valid -> session + permissions
P1 -> P0 : Open authorized dashboard
note over P1: else: invalid -> generic error
@enduml
